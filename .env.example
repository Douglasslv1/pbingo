DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bingo?schema=public"
PORT=3000
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Janela de espera da rodada (entrada de jogadores) em ms
ROUND_WAIT_MS=60000
# Intervalo entre sorteios de numeros em ms
DRAW_INTERVAL_MS=3000
# Atraso antes de abrir a proxima rodada apos o encerramento da atual
NEXT_ROUND_DELAY_MS=5000

# Custo em chaves (creditos) por cartela
TICKET_PRICE_CREDITS=1
# Valor em reais que cada cartela comprada adiciona ao premio acumulado da rodada
PRIZE_CONTRIBUTION_PER_TICKET=1.00

# NODE_ENV=production desabilita o endpoint /payments/mock-pix
NODE_ENV=development
# URL publica onde este servidor pode ser alcancado (usada como notification_url do Mercado Pago)
PUBLIC_BASE_URL="http://localhost:3000"
# Access Token da conta Mercado Pago (use as credenciais de TESTE durante o desenvolvimento)
MERCADOPAGO_ACCESS_TOKEN=""
# Chave secreta de assinatura de webhook (painel Mercado Pago > Webhooks). Opcional mas recomendado.
MERCADOPAGO_WEBHOOK_SECRET=""
# Preco em reais de cada chave/credito comprado via Pix
CREDIT_PRICE_BRL=1.00
