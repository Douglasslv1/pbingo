DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bingo_test?schema=public"
PORT=3001
JWT_SECRET="test-secret"
JWT_EXPIRES_IN="1h"

ROUND_INTERVAL_MINUTES=15
MIN_PLAYERS_PER_ROUND=5
DRAW_INTERVAL_MS=3000
NEXT_ROUND_DELAY_MS=5000

TICKET_PRICE_CREDITS=1
CREDIT_PRICE_BRL=1.00
HOUSE_FEE_PERCENT=20
MIN_WITHDRAWAL_BRL=1.00

# Vazios de proposito: impedem que valores reais do .env vazem para os testes
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_SECRET=""

# Limites por IP desligados: os testes fazem muitas requisicoes do mesmo IP (ha um teste dedicado)
RATE_LIMIT_ENABLED=false
RESEND_API_KEY=""
BREVO_API_KEY=""
FRONTEND_URL="http://localhost:5173"

# Evita poluir a saida dos testes com o log de cada requisicao
LOG_LEVEL=warn
