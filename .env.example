DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bingo?schema=public"
PORT=3000
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Intervalo da grade de rodadas em minutos: com 15, as rodadas comecam as :00, :15, :30 e :45
ROUND_INTERVAL_MINUTES=15
# Minimo de jogadores diferentes para a rodada comecar; abaixo disso ela e cancelada e as chaves devolvidas
MIN_PLAYERS_PER_ROUND=5
# Intervalo entre sorteios de numeros em ms
DRAW_INTERVAL_MS=3000
# Atraso antes de abrir a proxima rodada apos o encerramento da atual
NEXT_ROUND_DELAY_MS=5000

# Custo em chaves (creditos) por cartela
TICKET_PRICE_CREDITS=1
# Percentual (0-100) do valor de cada cartela retido pela casa; o restante vai para o premio acumulado.
# Ex.: cartela de R$ 1,00 com 20% => R$ 0,80 para o premio.
HOUSE_FEE_PERCENT=20

# NODE_ENV=production desabilita o endpoint /payments/mock-pix
NODE_ENV=development
# URL publica onde este servidor pode ser alcancado.
# O webhook a cadastrar no painel do Mercado Pago e PUBLIC_BASE_URL + /payments/webhook/mercadopago (evento "Order").
PUBLIC_BASE_URL="http://localhost:3000"
# Access Token da aplicacao Mercado Pago (integracao via Orders API; use credenciais de TESTE no desenvolvimento)
MERCADOPAGO_ACCESS_TOKEN=""
# Chave secreta de assinatura de webhook (painel Mercado Pago > Webhooks). Opcional mas recomendado.
MERCADOPAGO_WEBHOOK_SECRET=""
# Preco em reais de cada chave/credito comprado via Pix
CREDIT_PRICE_BRL=3.50
# Valor minimo de cada saque em reais (cada saque e pago manualmente pelo painel admin)
MIN_WITHDRAWAL_BRL=10.00

# Origens do frontend autorizadas (CORS e WebSocket), separadas por virgula. Vazio libera todas - use so em desenvolvimento.
CORS_ORIGINS="http://localhost:5173"
# false desliga os limites de tentativas por IP (login, cadastro, saque, Pix)
RATE_LIMIT_ENABLED=true
# Numero de proxies entre o jogador e o servidor; define de onde sai o IP real.
# No Railway sao 2 (medido em 2026-09-30: X-Forwarded-For chega como "cliente, borda" e valores forjados sao descartados)
TRUST_PROXY_HOPS=2

# URL publica do frontend, usada nos links enviados por e-mail
FRONTEND_URL="http://localhost:5173"
# Provedor de e-mail: usa o Resend se RESEND_API_KEY existir; senao o Brevo se BREVO_API_KEY existir.
# Sem nenhum dos dois (desenvolvimento), os e-mails sao apenas exibidos no console.
# Resend exige dominio proprio verificado; Brevo funciona com um remetente Gmail verificado.
RESEND_API_KEY=""
BREVO_API_KEY=""
# Remetente dos e-mails: dominio verificado no Resend ou remetente verificado no Brevo
EMAIL_FROM="Pbingu <nao-responda@seudominio.com.br>"
# Validade do link de redefinicao de senha em ms (padrao 1 hora)
PASSWORD_RESET_TTL_MS=3600000

# Nivel minimo de log: debug, info, warn ou error. Em producao (NODE_ENV=production) os logs saem em JSON.
LOG_LEVEL=info

# Promove esta conta (ja cadastrada) a ADMIN ao iniciar o servidor. Use uma vez e remova.
BOOTSTRAP_ADMIN_EMAIL=""

# Minutos que uma mesa (domino ou truco) espera completar antes de ser cancelada (chaves devolvidas)
DOMINO_QUEUE_TIMEOUT_MINUTES=10
# true libera o domino para todos; false deixa apenas administradores jogarem
DOMINO_ENABLED=false
# true deixa o domino gratuito (sem chave e sem premio), para testes
DOMINO_FREE=false
# Segundos que cada jogador tem para jogar; vencido o prazo, o sistema joga por ele
DOMINO_TURN_SECONDS=30
# true libera o truco para todos; false deixa apenas administradores jogarem
TRUCO_ENABLED=false
# Segundos para jogar ou responder a um pedido de truco; vencido o prazo, o sistema age pelo jogador
TRUCO_TURN_SECONDS=30
# true libera damas / xadrez para todos; false deixa apenas administradores jogarem
DAMAS_ENABLED=false
XADREZ_ENABLED=false
# Damas e xadrez gratuitos (sem chave e sem premio); false passa a cobrar o valor da mesa
BOARD_GAMES_FREE=true
# Segundos por lance nas damas e no xadrez; tempo esgotado e derrota
BOARD_TURN_SECONDS=60
