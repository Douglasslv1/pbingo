generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String    @db.VarChar(255)
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  role              UserRole  @default(PLAYER)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz
  birthDate         DateTime? @map("birth_date") @db.Date
  termsAcceptedAt   DateTime? @map("terms_accepted_at") @db.Timestamptz
  termsVersion      String?   @map("terms_version") @db.VarChar(20)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz

  credits             UserCredit?
  prizes              UserPrize?
  tickets             Ticket[]
  transactions        Transaction[]
  roundsWon           Round[]              @relation("RoundWinner")
  withdrawals         Withdrawal[]         @relation("WithdrawalOwner")
  reviewedWithdrawals Withdrawal[]         @relation("WithdrawalReviewer")
  PasswordResetToken  PasswordResetToken[]
  AccessLog           AccessLog[]
  DominoSeat          DominoSeat[]

  @@map("users")
}

enum UserRole {
  PLAYER
  ADMIN

  @@map("user_role")
}

model UserCredit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  balance   Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_credits")
}

model UserPrize {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  balanceFiat Decimal  @default(0.00) @map("balance_fiat") @db.Decimal(10, 2)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_prizes")
}

enum RoundStatus {
  WAITING
  IN_PROGRESS
  FINISHED
  CANCELLED

  @@map("round_status")
}

model Round {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status           RoundStatus @default(WAITING)
  accumulatedPrize Decimal     @default(0.00) @map("accumulated_prize") @db.Decimal(10, 2)
  drawnNumbers     Int[]       @default([]) @map("drawn_numbers")
  winnerUserId     String?     @map("winner_user_id") @db.Uuid
  startedAt        DateTime    @default(now()) @map("started_at") @db.Timestamptz
  scheduledAt      DateTime?   @map("scheduled_at") @db.Timestamptz
  endedAt          DateTime?   @map("ended_at") @db.Timestamptz

  winner  User?    @relation("RoundWinner", fields: [winnerUserId], references: [id])
  tickets Ticket[]

  @@map("rounds")
}

model Ticket {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roundId           String   @map("round_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  numbersMatrix     Json     @map("numbers_matrix")
  markedNumbers     Int[]    @default([]) @map("marked_numbers")
  isWinner          Boolean  @default(false) @map("is_winner")
  prizeAmount       Decimal? @map("prize_amount") @db.Decimal(10, 2)
  creditsSpent      Int      @default(1) @map("credits_spent")
  prizeContribution Decimal  @default(0.00) @map("prize_contribution") @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  round Round @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id])

  @@map("tickets")
}

enum TransactionType {
  PURCHASE_CREDITS
  SPEND_KEY
  PRIZE_PAYOUT
  WITHDRAWAL
  KEY_REFUND

  @@map("transaction_type")
}

model Transaction {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String          @map("user_id") @db.Uuid
  type              TransactionType
  amountFiat        Decimal         @default(0.00) @map("amount_fiat") @db.Decimal(10, 2)
  amountCredits     Int             @default(0) @map("amount_credits")
  status            String          @default("COMPLETED") @db.VarChar(50)
  providerReference String?         @map("provider_reference") @db.VarChar(255)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  user       User        @relation(fields: [userId], references: [id])
  withdrawal Withdrawal?

  @@index([providerReference])
  @@map("transactions")
}

enum WithdrawalStatus {
  PENDING
  PAID
  REJECTED

  @@map("withdrawal_status")
}

enum PixKeyType {
  CPF
  EMAIL
  PHONE
  RANDOM

  @@map("pix_key_type")
}

model Withdrawal {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String           @map("user_id") @db.Uuid
  transactionId    String           @unique @map("transaction_id") @db.Uuid
  amountFiat       Decimal          @map("amount_fiat") @db.Decimal(10, 2)
  cpf              String           @db.Char(11)
  pixKeyType       PixKeyType       @map("pix_key_type")
  pixKey           String           @map("pix_key") @db.VarChar(255)
  status           WithdrawalStatus @default(PENDING)
  paymentReference String?          @map("payment_reference") @db.VarChar(255)
  rejectionReason  String?          @map("rejection_reason") @db.VarChar(500)
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.Uuid
  reviewedAt       DateTime?        @map("reviewed_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  user        User        @relation("WithdrawalOwner", fields: [userId], references: [id])
  reviewedBy  User?       @relation("WithdrawalReviewer", fields: [reviewedByUserId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([status, createdAt])
  @@index([userId])
  @@map("withdrawals")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model AccessLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  event     String   @db.VarChar(30)
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("access_logs")
}

enum DominoTableStatus {
  WAITING
  PLAYING
  FINISHED
  CANCELLED

  @@map("domino_table_status")
}

model DominoTable {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  mode         String            @db.VarChar(20)
  teamMode     String            @map("team_mode") @db.VarChar(20)
  status       DominoTableStatus @default(WAITING)
  state        Json?
  prizePool    Decimal           @default(0.00) @map("prize_pool") @db.Decimal(10, 2)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  startedAt    DateTime?         @map("started_at") @db.Timestamptz
  finishedAt   DateTime?         @map("finished_at") @db.Timestamptz
  turnDeadline DateTime?         @map("turn_deadline") @db.Timestamptz

  seats DominoSeat[]
  moves DominoMove[]

  @@index([status, mode, teamMode, createdAt], map: "idx_domino_tables_queue")
  @@map("domino_tables")
}

model DominoSeat {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId           String   @map("table_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  seat              Int
  creditsSpent      Int      @map("credits_spent")
  prizeContribution Decimal  @map("prize_contribution") @db.Decimal(10, 2)
  prizeAmount       Decimal? @map("prize_amount") @db.Decimal(10, 2)
  timeouts          Int      @default(0)
  isAway            Boolean  @default(false) @map("is_away")
  joinedAt          DateTime @default(now()) @map("joined_at") @db.Timestamptz

  table DominoTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  user  User        @relation(fields: [userId], references: [id])

  @@unique([tableId, seat], map: "unique_domino_seat")
  @@unique([tableId, userId], map: "unique_domino_player")
  @@index([userId], map: "idx_domino_seats_user_id")
  @@map("domino_seats")
}

model DominoMove {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tableId    String   @map("table_id") @db.Uuid
  moveNumber Int      @map("move_number")
  seat       Int
  action     Json
  automatic  Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  table DominoTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([tableId, moveNumber], map: "unique_domino_move")
  @@map("domino_moves")
}
